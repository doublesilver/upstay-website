ADMIN_ID=
ADMIN_PW=
JWT_SECRET=

PUBLIC_ORIGIN=
DATA_DIR=

# 데모용 시드 데이터(Unsplash 이미지 12장) 자동 INSERT. 운영에서는 비워두세요.
# SEED_DEMO=1

# 이미지 호스트 분리 — 비우면 origin 로컬 서빙(/api/uploads/*).
# 설정 시 /api/uploads/X.jpg → ${HOST}/X.jpg로 prefix 교체 (R2 등 외부 CDN 직서빙).
# 빌드 타임에 inline되므로 변경 후 next build 재실행 필수.
# NEXT_PUBLIC_IMAGE_HOST=https://img.upstay.co.kr
